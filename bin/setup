#!/bin/bash

set -ex

mise install
# mise install does not put the pinned Node on PATH. Without this line, npm and yarn use the caller's Node.
eval "$(mise env --shell bash)"

op item get \
  "Secret key" \
  --account="my.1password.com" \
  --vault="Homepage" \
  --fields=password \
  --reveal \
| cat > key.txt
touch config/dev.secret.exs

mix do deps.get + ecto.create + ecto.migrate
MIX_ENV=test mix do ecto.create + ecto.migrate

cd apps/client/assets
npm install --global corepack
yarn
